GEMINI_API_KEY=your_gemini_api_key_here
HF_API_KEY=your_huggingface_api_key_here

# Optional story model overrides (defaults shown; use a currently available model)
# GEMINI_FLASH_MODEL=gemini-2.5-flash
# GEMINI_PRO_MODEL=gemini-pro-latest

# Optional image generation overrides (defaults shown)
# SD_MODEL_ID=runwayml/stable-diffusion-v1-5
# SD_DEVICE=auto
# SD_NUM_INFERENCE_STEPS=25
# SD_GUIDANCE_SCALE=7.5
# SD_WIDTH=512
# SD_HEIGHT=512
# SD_SEED=
# SD_OUTPUT_DIR=static/panels
# SD_ENABLE_ATTENTION_SLICING=true
# SD_ENABLE_CPU_OFFLOAD=false
# SD_SAFETY_CHECKER=false

# Optional PDF export override (default shown)
# PDF_OUTPUT_DIR=static/exports
